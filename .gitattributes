# Enforce LF line endings for all files on checkout
* text=auto eol=lf

# Explicitly LF for files deployed to Linux
*.sh text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.env text eol=lf
Dockerfile* text eol=lf
makefile text eol=lf
